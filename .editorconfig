root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,slnx}]
indent_size = 4

# EF Core writes these; they are regenerated by tooling, so formatting rules do not apply.
[server/src/Inkpact.Data/Migrations/*.cs]
generated_code = true
