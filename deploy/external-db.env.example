# Settings for docker-compose.external-db.yml: Inkpact against a PostgreSQL server you already run. With deploy/inkpact.sh,
# copy to deploy/.env; with a stack of its own (Unraid's Docker Compose Manager), paste into the stack's env file. Fill in;
# put a value with spaces or a $ in single quotes.

# What the image is built from: a checkout of this repository, or GitHub itself. Needed in a stack of its own; with
# deploy/inkpact.sh it is the checkout the script is in.
# INKPACT_SOURCE=/mnt/user/appdata/inkpact-src
# INKPACT_SOURCE=https://github.com/GotGeeks/Inkpact.git#main

# Where Postgres is. From a container on the default bridge network, that is the host's LAN address (not localhost).
# When Inkpact joins the Postgres container's network (INKPACT_NETWORK below), it is that container's name.
DB_HOST=
DB_PORT=5432
DB_NAME=inkpact
DB_USER=inkpact
# Any long random string (openssl rand -base64 24). inkpact.sh init creates the user with it.
DB_PASSWORD=

# Optional: the Postgres container, for `inkpact.sh init` to create the user and the database in it, and its superuser.
# PG_CONTAINER=postgresql18
# PG_SUPERUSER=postgres

# Optional: a Docker network to join instead of the default one (for example the one your Postgres container is on).
# INKPACT_NETWORK=proxynet

# The port on the host, and where the app's files go: a folder on the host, or the name of a Docker volume.
INKPACT_PORT=8080
# INKPACT_DATA=/mnt/user/appdata/inkpact

# Optional: the code for creating the administrator. Empty: the app makes one (inkpact.sh setup-code shows it).
# AUTH_SETUP_CODE=

# Optional: the image's name, and the container's.
# INKPACT_IMAGE=inkpact:local
# INKPACT_CONTAINER=inkpact
