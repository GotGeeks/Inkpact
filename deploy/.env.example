# Copy to .env next to docker-compose.yml and fill in the two required values.

# The database password. Any long random string (openssl rand -base64 24).
POSTGRES_PASSWORD=

# One-time code for creating the administrator on first visit. Any long random string.
AUTH_SETUP_CODE=

# Optional: the port on the host (default 8080), and a locally built image instead of the published one.
# INKPACT_PORT=8080
# INKPACT_IMAGE=inkpact:dev
