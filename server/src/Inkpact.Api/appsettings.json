{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ ",
        "UseUtcTimestamp": true,
        "ColorBehavior": "Disabled"
      }
    }
  },
  "AllowedHosts": "*",
  "Sidecar": {
    "ScriptPath": "sidecar/src/main.ts"
  }
}
