<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Inkpact.Data\Inkpact.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Geralt" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Inkpact.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tags imported HTML may keep: the same file the client's paste sanitiser reads. -->
    <EmbeddedResource Include="..\..\..\web\src\editor\allowList.json" LogicalName="Inkpact.Api.Import.allowList.json" Link="Import\allowList.json" />
    <!-- The words of the export's README are the client's (export.readme.* in each language), so the server writes no language of its own. -->
    <EmbeddedResource Include="..\..\..\web\src\locales\en.json" LogicalName="Inkpact.Api.Export.en.json" Link="Export\locales\en.json" />
    <EmbeddedResource Include="..\..\..\web\src\locales\nl.json" LogicalName="Inkpact.Api.Export.nl.json" Link="Export\locales\nl.json" />
  </ItemGroup>

</Project>
